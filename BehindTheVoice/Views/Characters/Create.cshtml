@model BehindTheVoice.ViewModels.CharacterCreateViewModel

@{
    ViewData["Title"] = "Yeni Karakter Ekle";
}

<div>
    <h2>Yeni Karakter Ekle</h2>

    <form asp-action="Create" asp-controller="Characters" enctype="multipart/form-data">

        <div>
            <label>Karakter Adı</label>
            <input asp-for="Name" type="text" accept="image/*"  required />
        </div>

        <div>
            <label>Karakter Resmi</label>
            <input asp-for="CharacterImage" type="file"  required />
        </div>


        <div>
            <button type="submit">Kaydet</button>
            <a asp-controller="Admin" asp-action="Index">İptal Et ve Geri Dön</a>
        </div>

    </form>
</div>