@{
    ViewData["Title"] = "Characters";
}

<div class="page-layout">
    <div class="sidebar">
        <div class="section-header">Recently Updated Characters</div>
        <div class="box-container">
            @{
                var recentCharacters = ViewBag.RecentCharacters as IEnumerable<BehindTheVoice.Models.VoiceCast>;
            }
            <table class="recently-updated-table">
                @if (recentCharacters != null)
                {
                    int charSayac = 1;
                    foreach (var character in recentCharacters)
                    {
                        if ((charSayac - 1) % 3 == 0)
                        {
                            @:<tr>
                        }
                        <td>
                            @{
                                string sUrlCharacterName = character.Character.Name.Replace(" ", "_");
                                string sTitleName = character.Production.Title.Replace(" ", "_");
                            }
                            <a class="grid-item-link" asp-controller="Characters" asp-action="Details" asp-route-productionTitle="@sTitleName" asp-route-name="@sUrlCharacterName">
                                <img src="@Url.Content(character.CharacterAppearanceUrl ?? "~/images/userphoto.png")" />
                                <label>@character.Character.Name</label>
                                <small>@character.Production.Title</small>
                            </a>
                        </td>
                        if(charSayac % 3 == 0)
                        {
                            @:</tr>
                        }
                        charSayac++;
                    }
                }
            </table>
        </div>
    </div>

    <div class="main-content">
        <div class="section-header">Characters Directory</div>
        <div class="box-container">
            <div class="list-controls">
                <label>List By:</label>
                <select id="slctType">
                    <option value="alphabetical">Alphabetical</option>
                    <option value="mostlike">Most Liked</option>
                    <option value="mostfavorite">Most Favorited</option>
                </select>
            </div>

            <div class="list-container">
                @if(recentCharacters != null)
                {
                    int sSayac = 1;
                    foreach (var character in recentCharacters)
                    {
                        <div class="list-item">
                            <div class="list-item-info">
                                @{
                                    string sUrlCharacterName = character.Character.Name.Replace(" ", "_");
                                    string sTitleName = character.Production.Title.Replace(" ", "_");
                                }
                                <a asp-controller="Characters" asp-action="Details" asp-route-productionTitle="@sTitleName" asp-route-name="@sUrlCharacterName">
                                    <div class="vcImg">
                                        <img src="@Url.Content(character.CharacterAppearanceUrl ?? "~/images/userphoto.png")" />
                                    </div>
                                </a>
                                <div class="list-item-text">
                                    <a asp-controller="Characters" asp-action="Details" asp-route-productionTitle="@sTitleName" asp-route-name="@sUrlCharacterName">
                                        <label style="cursor:pointer;">@(string.IsNullOrEmpty(character.Character.Name) ? "No Name Provided" : character.Character.Name)</label>
                                    </a>
                                    <div class="desc">@* @character.Character.Description *@ DESCRIPTION TEXT HERE</div>
                                </div>
                            </div>
                            <div class="list-item-stats">
                                <div class="stat-row">
                                    <span>👍</span> <span>561 likes</span>
                                </div>
                                <div class="stat-row">
                                    <span>⭐</span> <span>217 favorites</span>
                                </div>
                            </div>
                        </div>
                        sSayac++;
                    }
                }
            </div>
        </div>
    </div>
</div>