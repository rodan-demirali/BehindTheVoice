@{
    ViewData["Title"] = "Productions";
}

<div class="page-layout">
    <div class="sidebar">
        <div class="section-header">Recently Updated Productions</div>
        <div class="box-container">
            @{
                var recentProductions = ViewBag.RecentProductions as IEnumerable<BehindTheVoice.Models.Production>;
            }
            <table class="recently-updated-table">
                @if (recentProductions != null)
                {
                    int iSayac = 1;
                    foreach (var production in recentProductions)
                    {
                        if((iSayac - 1) % 3 == 0)
                        {
                            @:<tr>
                        }
                        <td>
                            @{
                                ProductionType sType = production.Type;
                                string sUrlTitle = production.Title.Replace(" ", "_");
                            }
                            <a class="grid-item-link" asp-controller="Productions" asp-action="Details" asp-route-type="@sType" asp-route-title="@sUrlTitle">
                                <img src="@Url.Content(production.PosterUrl ?? "~/images/userphoto.png")" />
                                <label>@(string.IsNullOrEmpty(production.Title) ? "No Name Provided" : production.Title)</label>
                                <small>Updated:<br />@production.UpdatedAt.ToString("d MMM yyyy")</small>
                            </a>
                        </td>
                        if(iSayac % 3 == 0)
                        {
                            @:</tr>
                        }
                        iSayac++;
                    }
                }
            </table>
        </div>
    </div>

    <div class="main-content">
        <div class="section-header">Productions Directory</div>
        <div class="box-container">
            <div class="list-controls">
                <label>List By:</label>
                <select id="slctType">
                    <option value="alphabetical">Alphabetical</option>
                    <option value="mostlike">Most Liked</option>
                    <option value="mostfavorite">Most Favorited</option>
                </select>
            </div>

            <div class="list-container">
                @if(recentProductions != null)
                {
                    int sSayac = 1;
                    foreach (var production in recentProductions)
                    {
                        <div class="list-item">
                            <div class="list-item-info">
                                <div class="vcImg">
                                    <img src="@Url.Content(production.PosterUrl ?? "~/images/moviePosterPlaceholder.png")" />
                                </div>
                                <div class="list-item-text">
                                    <label>@(string.IsNullOrEmpty(production.Title) ? "No Name Provided" : production.Title)</label>
                                    <div class="desc">@production.Description</div>
                                </div>
                            </div>
                            <div class="list-item-stats">
                                <div class="stat-row"><span>👍</span> <span>561 likes</span></div>
                                <div class="stat-row"><span>⭐</span> <span>217 favorites</span></div>
                            </div>
                        </div>
                        sSayac++;
                    }
                }
            </div>
        </div>
    </div>
</div>