@{
    ViewData["Title"] = "Voice Actors";
}

<div class="page-layout">
    <div class="sidebar">
        <div class="section-header">Recently Updated Actors</div>
        <div class="box-container">
            @{
                var recentActors = ViewBag.RecentActors as IEnumerable<BehindTheVoice.Models.VoiceActor>;
            }
            <table class="recently-updated-table">
                @if(recentActors != null)
                {
                    int iSayac = 1;
                    foreach (var actor in recentActors)
                    {
                        if((iSayac - 1) % 3 == 0)
                        {
                            @:<tr>
                        }
                        <td>
                            @{
                                string sUrlName = actor.FullName.Replace(" ", "_");
                            }
                            <a class="grid-item-link" asp-controller="VoiceActors" asp-action="Details" asp-route-name="@sUrlName">
                                <img src="@Url.Content(actor.ImageUrl ?? "~/images/userphoto.png")" />
                                <label>@(string.IsNullOrEmpty(actor.FullName) ? "No Name Provided" : actor.FullName)</label>
                                <small>Updated:<br />@actor.UpdatedAt.ToString("d MMM yyyy")</small>
                            </a>
                        </td>
                        if(iSayac % 3 == 0)
                        {
                            @:</tr>
                        }
                        iSayac++;
                    }
                }
            </table>
        </div>
    </div>

    <div class="main-content">
        <div class="section-header">Voice Actors Directory</div>
        <div class="box-container">
            <div class="list-controls">
                <label>List By:</label>
                <select id="slctType">
                    <option value="alphabetical">Alphabetical</option>
                    <option value="mostlike">Most Liked</option>
                    <option value="mostfavorite">Most Favorited</option>
                </select>
            </div>

            <div class="list-container">
                @if(recentActors != null)
                {
                    int sSayac = 1;
                    foreach (var actor in recentActors)
                    {
                        <div class="list-item">
                            <div class="list-item-info">
                                <div class="vcImg">
                                    <img src="@Url.Content(actor.ImageUrl ?? "~/images/userphoto.png")" />
                                </div>
                                <div class="list-item-text">
                                    <label>@(string.IsNullOrEmpty(actor.FullName) ? "No Name Provided" : actor.FullName)</label>
                                    <div class="desc">@actor.Description</div>
                                </div>
                            </div>
                            <div class="list-item-stats">
                                <div class="stat-row"><span>👍</span> <span>561 likes</span></div>
                                <div class="stat-row"><span>⭐</span> <span>217 favorites</span></div>
                            </div>
                        </div>
                        sSayac++;
                    }
                }
            </div>
        </div>
    </div>
</div>